DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Keep DB_ENGINE=sqlite for local setup, or switch to mysql after creating the database.
DB_ENGINE=sqlite
DB_NAME=room_booking_db
DB_USER=root
DB_PASSWORD=replace-with-your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306
